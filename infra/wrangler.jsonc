{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finance-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "exports": {
    "APIContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "WebContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "production": {
      "name": "finance-dashboard-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "MONGODB_DATABASE": "FinanceApp"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "API",
            "class_name": "APIContainer"
          },
          {
            "name": "WEB",
            "class_name": "WebContainer"
          }
        ]
      },
      "containers": [
        {
          "class_name": "APIContainer",
          "scheduling_policy": "durable_object",
          "images": {
            "base": {
              "dockerfile": "../backend/Dockerfile",
              "build_context": "../backend"
            }
          }
        },
        {
          "class_name": "WebContainer",
          "scheduling_policy": "durable_object",
          "images": {
            "base": {
              "dockerfile": "../frontend/Dockerfile",
              "build_context": "../frontend"
            }
          }
        }
      ],
      "services": [
        {
          "binding": "SEC_INGESTION",
          "service": "finance-sec-ingestion-production"
        }
      ]
    }
  }
}
